# ---------------------------------------------------------------------------
# cografya_web — environment variable template
#
# Copy to `.env.local` for local development. Never commit real values.
# PR-0w only DECLARES these placeholders; they are not read/wired yet.
# Runtime env reads will be validated at boot via a zod schema (CONVENTIONS §3)
# in the PR that first consumes an env var — no unvalidated process.env reads.
# ---------------------------------------------------------------------------

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). Public — client-exposed.
NEXT_PUBLIC_GA_ID=

# Google Search Console HTML-tag verification token. Public — client-exposed.
NEXT_PUBLIC_GSC_VERIFICATION=
