{
  "name": "cografya_web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "codegen": "openapi-typescript ./openapi/openapi.json --output ./lib/api/schema.ts",
    "codegen:check": "pnpm run codegen && git diff --exit-code -- lib/api/schema.ts",
    "generate:map": "node scripts/generate-map-paths.mjs",
    "generate:map:check": "pnpm run generate:map && git diff --exit-code -- lib/map/tr-provinces.generated.ts",
    "generate:world-map": "node scripts/generate-world-map-paths.mjs",
    "generate:world-map:check": "pnpm run generate:world-map && git diff --exit-code -- lib/map/world-countries.generated.ts",
    "generate:water": "node scripts/generate-tr-inland-water.mjs",
    "generate:water:check": "pnpm run generate:water && git diff --exit-code -- lib/map/tr-inland-water.generated.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky"
  },
  "dependencies": {
    "next": "16.2.10",
    "next-intl": "^4.13.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.0",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.4",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  }
}
